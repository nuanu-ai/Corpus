# Core application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
OAUTH_STATE_SECRET=

# Generate a 32-byte key as 64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=
COMPANY_DB_INTERNAL_SERVICE_SECRET=

# Local development
CORPUS_DEMO_MODE=true
STORAGE_DIR=./storage
TRUSTED_ORIGINS=http://localhost:3000

# AI providers (configure at least one supported provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CORPUS_CHAT_MODEL=

# Company-DB defaults
COMPANY_DB_AUTO_PROVISION=true
COMPANY_DB_HOST=127.0.0.1
COMPANY_DB_PORT_START=4100
COMPANY_DB_PORT_STRIDE=10
COMPANY_DB_INTERNAL_SERVICE_ID=corpus-local

# Optional semantic search
QDRANT_URL=
QDRANT_API_KEY=
COMPANY_DB_SEMANTIC_COLLECTION=corpus

# Optional background jobs
INNGEST_SIGNING_KEY=
CRON_SECRET=
ROUTINE_SCHEDULER_ENABLED=false

# Optional OAuth and connector credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
RUTTER_CLIENT_ID=
RUTTER_CLIENT_SECRET=
RUTTER_WEBHOOK_SECRET=
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_WEBHOOK_SECRET=
SHOPIFY_CLIENT_SECRET=

# Optional Telegram Bot API support (not MTProto user-account sync)
CORPUS_TELEGRAM_BOT_TOKEN=
CORPUS_TELEGRAM_BOT_WEBHOOK_SECRET=

# Optional document extraction providers
MINDEE_API_KEY=
VERYFI_API_KEY=
VERYFI_CLIENT_ID=
